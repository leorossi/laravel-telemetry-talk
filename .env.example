APP_NAME="Telemetry Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=telemetry_demo
DB_USERNAME=telemetry
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

DEMO_EXTERNAL_BASE_URL=https://inventory.example.test
DEMO_SLOW_PAGE_SIZE=50

GRAFANA_PUBLIC_URL=http://localhost:3000

PULSE_SLOW_REQUESTS_THRESHOLD=100
PULSE_SLOW_QUERIES_THRESHOLD=0
PULSE_SLOW_JOBS_THRESHOLD=200
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=0

OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=telemetry-demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=null
OTEL_LOGS_EXPORTER=null
OTEL_TRACES_SAMPLER_TYPE=always_on

# Dev-only microscope: /telescope and /demo/telescope. Never enable in production.
TELESCOPE_ENABLED=true

NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# 0.0 = nothing is sampled by default. routes/web.php opts in only /orders
# and /slow with Sample::always(); everything else never spends event quota.
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.0
NIGHTWATCH_COMMAND_SAMPLE_RATE=0.1
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=0.1
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
# Queries and outgoing requests are the point of the /slow demo, and the route
# whitelist already bounds the volume. Cache events stay off: pure noise.
NIGHTWATCH_IGNORE_QUERIES=false
NIGHTWATCH_IGNORE_CACHE_EVENTS=true
NIGHTWATCH_IGNORE_OUTGOING_REQUESTS=false
