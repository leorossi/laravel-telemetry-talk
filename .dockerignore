*.log
.DS_Store
.phpunit.result.cache
.phpunit.cache
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
bootstrap/cache/*.php
public/storage

# Container plumbing itself
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
